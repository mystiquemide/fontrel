# LLM (any OpenAI-compatible provider)
GROQ_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b
LLM_MODEL_FAST=openai/gpt-oss-20b

# FalkorDB
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# API: browser origins allowed to call it directly, and how many fresh traces may run at once
CORS_ORIGINS=http://localhost:3100
MAX_FRESH_TRACES=2

# Optional, raises openFDA rate limits
OPENFDA_API_KEY=
